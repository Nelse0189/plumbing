# =============================================================================
# NJ Plumbing — ALL environment variables (master template)
# =============================================================================
# Run once to create both local env files:
#   npm run setup:env:win     (Windows PowerShell)
#   npm run setup:env         (Mac/Linux)
#
# Or manually copy each section below into the target file shown in the header.
# Replace every replace-with-... placeholder with your real values.
# Never commit .env.local or functions/.env.nj-plumbing (gitignored).
# =============================================================================


# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# FILE: .env.local  (repo root — browser / Vite only)
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

# Google Maps — Map tab, geocoding, distance sort
# https://console.cloud.google.com/apis/credentials?project=nj-plumbing
# Enable: Maps JavaScript API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_API_KEY=AIzaSy-replace-with-your-maps-browser-key

# Dispatch UI defaults (optional)
VITE_DISPATCH_ORIGIN_ADDRESS=216 Christian Lane, Berlin, CT
VITE_DISPATCH_MORNING_HOUR=7

# Microsoft Teams PDF test page (/teams-test) — optional
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000


# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# FILE: functions/.env.nj-plumbing  (server secrets — NEVER use VITE_ prefix)
# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

# --- OpenAI (required for Plaud Calls + work-order PDF extraction) ---
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol

# --- Google Maps (production deploy + getPublicAppConfig) ---
GOOGLE_MAPS_API_KEY=AIzaSy-replace-with-your-maps-key

# --- Plaud (required for Calls tab) ---
PLAUD_REFRESH_TOKEN=replace-with-plaud-refresh-token
PLAUD_ACCESS_TOKEN=
PLAUD_API_BASE=https://platform.plaud.ai/developer/api

# --- Microsoft Graph (Teams PDF import) — optional ---
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Twilio (SMS + voice confirmations) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555551212
SMS_TEST_RECIPIENT=+18609643025
COMPANY_NAME=NJ Plumbing

# --- Dispatch / scheduled reminders ---
DISPATCH_ORIGIN_ADDRESS=216 Christian Lane, Berlin, CT
DISPATCH_MORNING_HOUR=7
BUSINESS_TIME_ZONE=America/New_York
MORNING_REMINDER_HOUR=8

# --- Gmail voice-email ingestion — optional ---
GMAIL_EMAIL=your-inbox@example.com
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GMAIL_REDIRECT_URI=http://localhost

# --- Gemini — optional (voice email path only) ---
GEMINI_API_KEY=replace-with-gemini-api-key-if-using-voice-email
