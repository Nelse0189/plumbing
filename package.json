  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:env": "bash scripts/setup-local-env.sh",
    "firebase:login": "npx firebase-tools login --no-localhost",
