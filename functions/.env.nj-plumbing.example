# Same as functions/.env.example — copy to functions/.env.nj-plumbing for Firebase deploy.
# See ../env.template for the full annotated master list.

# Plaud call analysis uses OPENAI_MODEL. PDF import and schedule detection use gpt-5.6-terra.
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol

GOOGLE_MAPS_API_KEY=AIzaSy-replace-with-your-maps-key

PLAUD_REFRESH_TOKEN=replace-with-plaud-refresh-token
PLAUD_ACCESS_TOKEN=
PLAUD_API_BASE=https://platform.plaud.ai/developer/api

MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
# Server-side Teams sync while the app is closed (Azure app: Web redirect URI
# https://us-central1-<project>.cloudfunctions.net/teamsServerConnectCallback + client secret).
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-azure-app-client-secret

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555551212
# Verified caller ID for AI confirmation calls (shop cell). Leave blank to use TWILIO_PHONE_NUMBER.
TWILIO_VOICE_CALLER_ID=
# Recorded plumber job calls: Voice webhook
# https://us-central1-nj-plumbing.cloudfunctions.net/handlePlumberInbound
# Shop cell that receives "customer wants the head plumber" texts from AI calls.
HEAD_PLUMBER_PHONE=+18605439082

# ElevenLabs Conversational AI. Twilio places the call; ElevenLabs owns turns.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2
ELEVENLABS_AGENT_ID=

# OpenAI Realtime (outbound confirmation calls + Voice Agent tab).
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_PROJECT_ID=proj_replace_with_openai_project_id
OPENAI_WEBHOOK_SECRET=whsec_replace_with_openai_webhook_secret
# VOICE_MEDIA_STREAM_HOST=handlevoicemediastream-xxxxx-uc.a.run.app
SMS_TEST_RECIPIENT=+18609643025
COMPANY_NAME=NJ Plumbing

DISPATCH_ORIGIN_ADDRESS=216 Christian Lane, Berlin, CT
DISPATCH_MORNING_HOUR=7
BUSINESS_TIME_ZONE=America/New_York
MORNING_REMINDER_HOUR=8

GMAIL_EMAIL=your-inbox@example.com
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GMAIL_REDIRECT_URI=http://localhost

GEMINI_API_KEY=replace-with-gemini-api-key-if-using-voice-email
