# Server secrets — includes OPENAI_API_KEY, Plaud, Twilio, Maps, Gmail, etc.
# See env.template at repo root for the complete annotated list.
#
# Copy:  copy functions\.env.example functions\.env.nj-plumbing
# Or:    npm run setup:env:win

# --- OpenAI (Plaud Calls + work-order PDFs) — REQUIRED for Calls tab ---
# Plaud call analysis uses OPENAI_MODEL. PDF import and schedule detection use gpt-5.6-terra.
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol

GOOGLE_MAPS_API_KEY=AIzaSy-replace-with-your-maps-key

PLAUD_REFRESH_TOKEN=replace-with-plaud-refresh-token
PLAUD_ACCESS_TOKEN=
PLAUD_API_BASE=https://platform.plaud.ai/developer/api
# Plaud developer application. Register this exact redirect URI:
# http://localhost:8199/auth/callback
PLAUD_CLIENT_ID=replace-with-plaud-application-client-id
PLAUD_CLIENT_SECRET=replace-with-plaud-application-client-secret

MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-azure-app-client-secret

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555551212
# Verified caller ID for AI confirmation calls (shop cell). Leave blank to use TWILIO_PHONE_NUMBER.
TWILIO_VOICE_CALLER_ID=
# Recorded plumber job calls: set this Twilio number's Voice webhook to
# https://us-central1-nj-plumbing.cloudfunctions.net/handlePlumberInbound
# so inbound customer calls ring the truck cell and are recorded.
# Shop cell that receives "customer wants the head plumber" texts from AI calls.
HEAD_PLUMBER_PHONE=+18605439082

# ElevenLabs Conversational AI for arrival-window confirmation calls.
# Twilio places the call; ElevenLabs owns pauses and turn-taking.
# Flash TTS is ~$0.05 per 1,000 characters. Create a key at:
# https://elevenlabs.io/app/settings/api-keys
# Default voice is Adam. Copy another Voice ID from Voices when you want to change it.
# Optional: paste an existing ConvAI agent ID instead of auto-creating one.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2
ELEVENLABS_AGENT_ID=

# OpenAI Realtime SIP (outbound confirmation calls) and the Voice Agent tab.
# gpt-realtime-mini is the cheaper model; set gpt-realtime-2.1 for higher quality.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_PROJECT_ID=proj_replace_with_openai_project_id
# Create a webhook at https://platform.openai.com/settings/organization/webhooks
# Event: realtime.call.incoming
# URL: https://us-central1-nj-plumbing.cloudfunctions.net/handleOpenAiRealtimeWebhook
OPENAI_WEBHOOK_SECRET=whsec_replace_with_openai_webhook_secret
# Optional leftover from the Media Streams path:
# VOICE_MEDIA_STREAM_HOST=handlevoicemediastream-xxxxx-uc.a.run.app
SMS_TEST_RECIPIENT=+18609643025
# Phone SMS tab uses an Android handset instead of Twilio. Pairing token is
# created in the app; it is not stored in this file.
COMPANY_NAME=NJ Plumbing

DISPATCH_ORIGIN_ADDRESS=216 Christian Lane, Berlin, CT
DISPATCH_MORNING_HOUR=7
BUSINESS_TIME_ZONE=America/New_York
MORNING_REMINDER_HOUR=8

GMAIL_EMAIL=your-inbox@example.com
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GMAIL_REDIRECT_URI=http://localhost

GEMINI_API_KEY=replace-with-gemini-api-key-if-using-voice-email

# Plaid (Bills tab bank transactions). Keep the secret in this file only.
# PLAID_SECRET can stay as the sandbox key. Live banks need PLAID_SECRET_PRODUCTION.
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SECRET=replace-with-plaid-sandbox-secret
PLAID_SECRET_PRODUCTION=replace-with-plaid-production-secret
PLAID_ENV=production
