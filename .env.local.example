# Local frontend env (repo root). Copy to .env.local — never commit the real file.
# cp .env.local.example .env.local
#
# If you already have functions/.env.nj-plumbing with GOOGLE_MAPS_API_KEY,
# npm run dev and npm run build pick that up automatically (no duplicate needed).

VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here
VITE_DISPATCH_ORIGIN_ADDRESS=216 Christian Lane, Berlin, CT
VITE_DISPATCH_MORNING_HOUR=7
# Optional override (otherwise build reads GOOGLE_MAPS_API_KEY from functions/.env.nj-plumbing)
# VITE_GOOGLE_MAPS_API_KEY=
