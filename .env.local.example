# =============================================================================
# NJ Plumbing — local frontend env (repo root)
# =============================================================================
# Windows PowerShell:
#   copy .env.local.example .env.local
#   notepad .env.local
#
# Mac/Linux:
#   cp .env.local.example .env.local
#
# Or run:  npm run setup:env        (Mac/Linux)
#           npm run setup:env:win    (Windows PowerShell)
#
# Never commit .env.local — it is gitignored.
# Maps: you can set VITE_GOOGLE_MAPS_API_KEY here OR GOOGLE_MAPS_API_KEY in
# functions/.env.nj-plumbing (build/dev reads both).
# =============================================================================

# --- Google Maps (Map tab + geocoding + distance sort) ---
# Create at: https://console.cloud.google.com/apis/credentials?project=nj-plumbing
# Enable: Maps JavaScript API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_API_KEY=AIzaSy-replace-with-your-maps-browser-key

# --- Dispatch defaults (shown in UI; optional overrides) ---
VITE_DISPATCH_ORIGIN_ADDRESS=216 Christian Lane, Berlin, CT
VITE_DISPATCH_MORNING_HOUR=7

# --- Microsoft Teams PDF import test page (/teams-test) — optional ---
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
